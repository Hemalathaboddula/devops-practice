pipeline {
    agent any

    stages {

        stage('Install') {
            steps {
                sh '''
                python3 -m venv venv
                . venv/bin/activate
                pip install --upgrade pip
                pip install -r jenkins/requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                . venv/bin/activate
                pytest jenkins/
                '''
            }
        }

        stage('Build') {
            steps {
                echo "Build step completed"
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                mkdir -p /tmp/app
                cp jenkins/app.py /tmp/app/
                '''
            }
        }
    }
}